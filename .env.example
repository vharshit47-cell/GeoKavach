# Optional administrative operations only; NOT required by this MVP.
# Never prefix a service-role/secret key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Groq is called exclusively on the server. Select a model enabled for your account.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Must match Supabase Auth Site URL and allowed redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional no-charge Google Maps Embed API (requires Google Cloud billing setup).
# Restrict this browser-visible key to your website referrers and Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Preferred server-side road routing. When absent/unavailable, the planner uses the public OSRM service.
# Never prefix this key with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Emergency assistance: disabled until a monitored receiving team and providers are configured.
# Server-only. First test using your own email and mobile number. See EMERGENCY_SETUP.md.
EMERGENCY_DELIVERY_ENABLED=false
EMERGENCY_AUTHORITY_NAME=
EMERGENCY_TO_EMAIL=
EMERGENCY_TO_SMS=
EMERGENCY_FROM_EMAIL=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
